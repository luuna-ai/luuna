# luuna-atlas bash completions
# Add to ~/.bashrc: eval "$(luuna-atlas completions bash)"
_atlas() {
  local cur="${COMP_WORDS[COMP_CWORD]}"
  COMPREPLY=( $(compgen -W "init add record edit query setup prime hook onboard status validate prune archive restore search show stale rank outcome doctor ready sync delete delete-domain move learn compact config diff upgrade completions audit --version --json --quiet --verbose --timing --allow-unknown-types --allow-domain-mismatch --format" -- "$cur") )
}
complete -F _atlas luuna-atlas
complete -F _atlas la
